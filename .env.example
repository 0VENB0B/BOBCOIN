# ── BOBCOIN / GUCOIN environment template ─────────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# Discord bot token (GUCOIN_TOKEN / BOBCOIN_TOKEN also accepted as fallbacks)
DISCORD_TOKEN=

# Google Cloud project where Firestore lives (bank data is stored here)
FIREBASE_PROJECT_ID=

# Path to the Firebase service-account JSON (keep out of git)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional — enables the BOB chat AI + AI loan approval. Leave empty to disable.
ANTHROPIC_API_KEY=

# Command prefix, defaults to $
#GUCOIN_PREFIX=$

# Bot owner Discord ID (used for owner-only checks)
#GUCOIN_OWNER_ID=

# Comma-separated admin role IDs for $BD etc.
#GUCOIN_ADMIN_ROLE_IDS=

# Dev commands ($setluck / $seed / $guardian_run / $bankhealth) stay disabled
# unless this is ON — AND the caller is an admin/owner. 0/empty = disabled.
#GUCOIN_DEV_MODE=0

# Comma-separated role IDs that $BD is allowed to sell (empty = $BD sells
# nothing). $BD itself is admin-only.
#GUCOIN_BD_ROLE_IDS=

# Logging level: DEBUG / INFO / WARNING / ERROR (default INFO)
#LOG_LEVEL=INFO

# Casino audit log — copies of deleted game results are forwarded to this
# Discord channel ID (0 or unset = disabled). Lets disputes be reviewed after
# the 45s casino auto-delete.
#GUCOIN_AUDIT_CHANNEL_ID=0

# Slot jackpot base rate per spin (default 0.015625 ≈ 8/512 ≈ 1.56%).
# Tune from collected house win-rate stats ($stats).
#GUCOIN_SLOT_JACKPOT_BASE=0.015625
